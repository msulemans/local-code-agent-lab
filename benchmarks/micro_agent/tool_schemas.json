{
  "schema_version": 1,
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "list_files",
        "description": "List allowed workspace files in stable lexical order.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "default": "."},
            "max_depth": {"type": "integer", "minimum": 0, "maximum": 20, "default": 4},
            "max_results": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 200}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_code",
        "description": "Search allowed UTF-8 workspace files and return bounded matching lines. Use file_paths to search specific files instead of a directory.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query"],
          "properties": {
            "query": {"type": "string", "minLength": 1, "maxLength": 1000},
            "path": {"type": "string", "default": "."},
            "glob": {"type": ["string", "null"], "default": null},
            "max_results": {"type": "integer", "minimum": 1, "maximum": 200, "default": 40},
            "regex": {"type": "boolean", "default": false},
            "case_sensitive": {"type": "boolean", "default": true},
            "file_paths": {"type": ["array", "null"], "items": {"type": "string"}, "default": null}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a bounded line-numbered excerpt from one allowed UTF-8 workspace file.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {"type": "string"},
            "start_line": {"type": "integer", "minimum": 1, "default": 1},
            "end_line": {"type": ["integer", "null"], "minimum": 1, "default": null},
            "max_lines": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 400}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "apply_patch",
        "description": "Apply one bounded unified diff to existing allowed UTF-8 files in the disposable workspace.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patch"],
          "properties": {
            "patch": {"type": "string", "minLength": 1, "maxLength": 65536}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "edit_file",
        "description": "Replace one exact, unique snippet inside an existing tracked UTF-8 file. Copy old_string exactly as read (it must appear once), and supply the replacement text. Prefer this over write_file for large files and over apply_patch when a unified diff is hard to construct.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "old_string", "new_string"],
          "properties": {
            "path": {"type": "string"},
            "old_string": {"type": "string", "minLength": 1, "maxLength": 65536},
            "new_string": {"type": "string", "maxLength": 65536}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "write_file",
        "description": "Replace the complete contents of one existing tracked UTF-8 file in the disposable workspace. Prefer this over apply_patch when a line-accurate unified diff is hard to construct: read the file first, then supply the full new file content.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "content"],
          "properties": {
            "path": {"type": "string"},
            "content": {"type": "string", "minLength": 1, "maxLength": 1048576}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "run_tests",
        "description": "Run one registered test command in the disposable sandbox and return controller-bounded output plus exit evidence. Supply only command_name; timeout and output limits are owned by the trusted controller.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command_name"],
          "properties": {
            "command_name": {"type": "string", "enum": ["python-unittest"]}
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "git_diff",
        "description": "Return a bounded working-tree Git diff for allowed workspace paths.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "default": "."},
            "staged": {"type": "boolean", "default": false}
          }
        }
      }
    }
  ]
}
